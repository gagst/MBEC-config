@prefix s4bldg: <https://saref.etsi.org/saref4bldg/v2.1.1/> .
@prefix s4bldg_lite: <https://github.com/gagst/s4bldg_lite> .
s4bldg_lite:a-heat-pump-tuna a s4bldg:EnergyConversionDevice ;
    s4bldg:isContainedIn s4bldg_lite:space-alice ;
    s4bldg:nominalHeatingCapacity "210 kW" ;
    s4bldg:nominalPowerConsumption "70 kW" .
s4bldg_lite:a-national-electric-grid-tamarin a s4bldg:FlowMeter ;
    s4bldg:apparentPowerMax "100 kW",
        "20 kW" ;
    s4bldg:isContainedIn s4bldg_lite:space-alice .
s4bldg_lite:an-electrical-energy-storage-system-tortoise a s4bldg:ElectricFlowStorageDevice ;
    s4bldg:apparentPowerMax "6 kW" ;
    s4bldg:isContainedIn s4bldg_lite:space-alice ;
    s4bldg:nominalPowerConsumption "6 kW" ;
    s4bldg:storageType "BATTERY" .
s4bldg_lite:toucan a s4bldg:SpaceHeater ;
    s4bldg:isContainedIn s4bldg_lite:space-alice .
s4bldg_lite:trout a s4bldg:ElectricAppliance ;
    s4bldg:isContainedIn s4bldg_lite:space-alice .
s4bldg_lite:building-alice a s4bldg:Building .
s4bldg_lite:space-alice a s4bldg:BuildingSpace ;
    s4bldg:isSpaceOf s4bldg_lite:building-alice .
{% endset %}


